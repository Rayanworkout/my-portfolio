---
import Base from '../../../layouts/Base.astro';
import { posts, categories, label, postUrl, dateLabel, excerpt } from '../../../lib/content.js';
import publications from '../../../data/publications.json';
const allPosts = await posts();
const topCategories = categories(allPosts).slice(0, 8);
---
<Base lang="en" title="Technical blog"
  description="Rayan’s personal notes on Linux, networking, security, automation and development.">
<section class="blog-intro shell">
  <p class="section-kicker">Personal blog</p>
  <h1>Field notes.</h1>
  <p>Configurations, experiments and solutions for systems, networking and development.</p>
</section>
<div class="shell blog-grid">
  <aside class="topic-panel">
    <h2>Explore by topic</h2>
    <nav aria-label="Filter articles by topic"><button type="button" class="blog-filter" data-blog-filter aria-pressed="true">All articles <span>{allPosts.length}</span></button>{topCategories.map(([tag, count]) => <button type="button" class="blog-filter" data-blog-filter data-tag={tag} data-label={label(tag, 'en')} aria-pressed="false">{label(tag, 'en')} <span>{count}</span></button>)}</nav><a class="all-topics"
      href="/en/blog/categories/">All categories <span aria-hidden="true">↗</span></a>
  </aside>
  <section class="post-list" aria-labelledby="all-posts-title">
    <div class="list-heading">
      <h2 id="all-posts-title">All articles</h2><span id="post-count">{allPosts.length} notes</span>
    </div>{allPosts.map((post) => <article class="post-row" data-tags={post.data.tags.join('|')}><time datetime={post.id.slice(0,
        10)}>{dateLabel(post, 'en')}</time>
      <div><span class="post-language" aria-label="Language: English">EN</span>
        <h3 lang="en"><a href={`/en${postUrl(post)}`}>{post.data.title}</a></h3>
        <p lang="en">{excerpt(post, 'en')}</p>
      </div><a class="row-link" href={`/en${postUrl(post)}`} aria-label={`Read: ${post.data.title}`}>Read <span
          aria-hidden="true">↗</span></a>
    </article>)}
  </section>
</div>
<section class="section shell medium-section" aria-labelledby="medium-title">
  <div class="section-heading">
    <p class="section-kicker">Archives</p>
    <h2 id="medium-title">Also on Medium.</h2>
  </div>
  <div class="medium-links">{publications.map((article) => <a href={article.link} target="_blank"
      rel="noopener noreferrer">{article.titleEn} <span aria-hidden="true">↗</span></a>)}</div>
</section>
<script>
  const filters = [...document.querySelectorAll('[data-blog-filter]')];
  const articles = [...document.querySelectorAll('.post-list .post-row')];
  filters.forEach((filter) => filter.addEventListener('click', () => {
    const tag = filter.dataset.tag;
    const count = articles.reduce((total, article) => {
      const match = !tag || article.dataset.tags.split('|').includes(tag);
      article.hidden = !match;
      return total + Number(match);
    }, 0);
    filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
    document.querySelector('#all-posts-title').textContent = tag ? `Articles : ${filter.dataset.label}` : 'All articles';
    document.querySelector('#post-count').textContent = `${count} note${count > 1 ? 's' : ''}`;
  }));
</script>
</Base>
