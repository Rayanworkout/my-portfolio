---
import { Image } from 'astro:assets';

const { project, lang = 'fr' } = Astro.props;
const images = import.meta.glob('../assets/projects/*.jpg', { eager: true, import: 'default' });
---

<article class="project-card">
  {project.image ? (
    <div class="project-card-image">
      <Image src={images[`../assets/projects/${project.image}.jpg`]} width={680} format="webp" alt="" loading="lazy" />
    </div>
  ) : (
    <div class="project-card-visual" aria-hidden="true">
      {project.visual.map((part) => <span>{part}</span>)}
    </div>
  )}
  <div class="project-card-body">
    <h3>{project.name}</h3>
    <p>{lang === 'en' ? project.descriptionEn : project.description}</p>
    <ul class="tag-list" aria-label={lang === 'en' ? `Technologies for ${project.name}` : `Technologies pour ${project.name}`}>
      {project.keywords.map((keyword) => <li>{keyword}</li>)}
    </ul>
    {(project.link || project.githubLink) && <div class="project-card-links">
      {project.link && <a href={project.link}>{lang === 'en' ? 'View project' : 'Voir le projet'} <span aria-hidden="true">↗</span></a>}
      {project.githubLink && <a href={project.githubLink}>{lang === 'en' ? 'Source code' : 'Code source'} <span aria-hidden="true">↗</span></a>}
    </div>}
  </div>
</article>
