---
import '../styles/global.css';
import dmFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import plexFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
const { title, description, type = 'website', noindex = false, lang = 'fr' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const onBlog = Astro.url.pathname.startsWith('/blog/');
const onProjects = Astro.url.pathname.startsWith('/projets/');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f7f9fd" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title} | Rayan</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical.href} />}
    <meta property="og:site_name" content="Rayan" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={dmFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={plexFont} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Rayan, accueil" translate="no">Rayan<span>.</span></a>
        <nav aria-label="Navigation principale">
          <a href="/projets/" aria-current={onProjects ? 'page' : undefined}>Projets</a>
          <a href="/#competences">Compétences</a>
          <a href="/blog/" aria-current={onBlog ? 'page' : undefined}>Blog</a>
          <a href="https://flowshift.fr/" target="_blank" rel="noopener noreferrer">Flowshift <span aria-hidden="true">↗</span></a>
          <button class="nav-contact" type="button" data-copy-email aria-label="Copier l’adresse contact@rayan.world">contact@rayan.world</button>
          <span class="sr-only" id="copy-email-status" role="status"></span>
        </nav>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><a class="brand" href="/" translate="no">Rayan<span>.</span></a><p>Développement backend, flux de données et infrastructure.</p></div>
        <nav aria-label="Liens complémentaires">
          <a href="/projets/">Projets</a>
          <a href="/blog/">Blog</a>
          <a href="https://flowshift.fr/" target="_blank" rel="noopener noreferrer">Flowshift</a>
          <a href="https://github.com/Rayanworkout">GitHub</a>
          <a href="mailto:contact@rayan.world">Courriel</a>
        </nav>
      </div>
    </footer>
    <script>
  const button = document.querySelector('[data-copy-email]');
  const status = document.querySelector('#copy-email-status');
  let reset;
  button.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.textContent.trim());
      button.dataset.copyState = 'copied';
      status.textContent = 'Adresse copiée.';
    } catch {
      button.dataset.copyState = 'failed';
      status.textContent = 'Copie impossible. Utilisez le lien de contact en bas de page.';
    }
    clearTimeout(reset);
    reset = setTimeout(() => { delete button.dataset.copyState; status.textContent = ''; }, 2500);
  });
    </script>
  </body>
</html>
