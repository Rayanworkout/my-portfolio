---
import ProjectCard from './ProjectCard.astro';

const { projects, lang = 'fr' } = Astro.props;
---

<div class="projects-grid">
  {projects.map((project) => (
    <div class="project-item" data-keywords={project.keywords.map((keyword) => keyword.toLowerCase()).join('|')}>
      <ProjectCard project={project} lang={lang} />
    </div>
  ))}
</div>
