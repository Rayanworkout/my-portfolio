---
import ProjectCard from './ProjectCard.astro';

const { projects } = Astro.props;
const columns = Math.max(1, Math.ceil(projects.length / 2));
---

<div
  class="projects-grid"
  style={`--project-columns: ${columns};`}
>
  {projects.map((project) => (
    <div class="project-item">
      <ProjectCard project={project} />
    </div>
  ))}
</div>

<style>
  
  .projects-grid {
  display: grid;
  grid-template-columns: repeat(var(--project-columns), minmax(0, 1fr));
  grid-auto-rows: 1fr;
  gap: 1rem;
  align-items: stretch;
}

.project-item {
  display: flex;
  min-width: 0;
}

/* Conteneur principal de chaque card */
.project-item :global(.project-card) {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  min-width: 0;
  padding: 0.75rem;
  border-radius: 20px;
  overflow: hidden;
}

/* Réduire les espaces verticaux sans rogner l'image. */
.project-item :global(.project-card-body) {
  gap: 0.25rem;
  padding-top: 0.4rem;
}

/* Titres plus petits */
.project-item :global(.project-card h1),
.project-item :global(.project-card h2),
.project-item :global(.project-card h3) {
  font-size: 0.95rem;
  line-height: 1.3;
  margin: 0.3rem 0 0.2rem;
}

/* Descriptions plus compactes */
.project-item :global(.project-card p) {
  font-size: 0.82rem;
  line-height: 1.45;
  margin: 0.15rem 0;
}

.project-item :global(.project-card-links) {
  padding-top: 0.35rem;
}

@media (max-width: 768px) {
  .projects-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

}

@media (max-width: 480px) {
  .projects-grid {
    grid-template-columns: 1fr;
  }
}
</style>