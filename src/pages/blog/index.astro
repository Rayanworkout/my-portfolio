---
import Base from '../../layouts/Base.astro';
import { posts, categories, label, postUrl, dateLabel, excerpt } from '../../lib/content.js';
import publications from '../../data/publications.json';
const allPosts = await posts();
const topCategories = categories(allPosts).slice(0, 8);
---
<Base title="Blog technique"
  description="Notes personnelles de Rayan sur Linux, le réseau, la sécurité, l’automatisation et le développement.">
<section class="blog-intro shell">
  <p class="section-kicker">Blog personnel</p>
  <h1>Notes de terrain.</h1>
  <p>Configurations, essais et solutions autour des systèmes, du réseau et du développement.</p>
</section>
<div class="shell blog-grid">
  <aside class="topic-panel">
    <h2>Explorer par sujet</h2>
    <nav aria-label="Filtrer les articles par sujet"><button type="button" class="blog-filter" data-blog-filter aria-pressed="true">Tous les articles <span>{allPosts.length}</span></button>{topCategories.map(([tag, count]) => <button type="button" class="blog-filter" data-blog-filter data-tag={tag} data-label={label(tag)} aria-pressed="false">{label(tag)} <span>{count}</span></button>)}</nav><a class="all-topics"
      href="/blog/categories/">Toutes les catégories <span aria-hidden="true">↗</span></a>
  </aside>
  <section class="post-list" aria-labelledby="all-posts-title">
    <div class="list-heading">
      <h2 id="all-posts-title">Tous les articles</h2><span id="post-count">{allPosts.length} notes</span>
    </div>{allPosts.map((post) => <article class="post-row" data-tags={post.data.tags.join('|')}><time datetime={post.id.slice(0,
        10)}>{dateLabel(post)}</time>
      <div><span class="post-language" aria-label={`Langue : ${post.data.lang==='fr' ? 'français' : 'anglais'
          }`}>{post.data.lang.toUpperCase()}</span>
        <h3 lang={post.data.lang}><a href={postUrl(post)}>{post.data.title}</a></h3>
        <p lang={post.data.lang}>{excerpt(post)}</p>
      </div><a class="row-link" href={postUrl(post)} aria-label={`Lire : ${post.data.title}`}>Lire <span
          aria-hidden="true">↗</span></a>
    </article>)}
  </section>
</div>
<section class="section shell medium-section" aria-labelledby="medium-title">
  <div class="section-heading">
    <p class="section-kicker">Archives</p>
    <h2 id="medium-title">Aussi sur Medium.</h2>
  </div>
  <div class="medium-links">{publications.map((article) => <a href={article.link} target="_blank"
      rel="noopener noreferrer">{article.title} <span aria-hidden="true">↗</span></a>)}</div>
</section>
<script>
  const filters = [...document.querySelectorAll('[data-blog-filter]')];
  const articles = [...document.querySelectorAll('.post-list .post-row')];
  filters.forEach((filter) => filter.addEventListener('click', () => {
    const tag = filter.dataset.tag;
    const count = articles.reduce((total, article) => {
      const match = !tag || article.dataset.tags.split('|').includes(tag);
      article.hidden = !match;
      return total + Number(match);
    }, 0);
    filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
    document.querySelector('#all-posts-title').textContent = tag ? `Articles : ${filter.dataset.label}` : 'Tous les articles';
    document.querySelector('#post-count').textContent = `${count} note${count > 1 ? 's' : ''}`;
  }));
</script>
</Base>
