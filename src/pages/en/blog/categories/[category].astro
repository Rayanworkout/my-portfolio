---
import Base from '../../../../layouts/Base.astro';
import { posts, categories, slug, label, postUrl, dateLabel, excerpt } from '../../../../lib/content.js';
export async function getStaticPaths() {
  const allPosts = await posts();
  return categories(allPosts).map(([tag]) => ({ params: { category: slug(tag) }, props: { tag, matching: allPosts.filter((post) => (post.data.tags.length ? post.data.tags : ['Sans catégorie']).includes(tag)) } }));
}
const { tag, matching } = Astro.props;
---
<Base lang="en" title={`Articles: ${label(tag, 'en')}`} description={`All of Rayan’s technical notes on ${label(tag, 'en')}.`}>
  <section class="shell subpage-intro category-detail"><a class="back-link" href="/en/blog/categories/">All categories</a><p class="section-kicker">Category</p><h1>{label(tag, 'en')}</h1><p>{matching.length} {matching.length === 1 ? 'article' : 'articles'} in this category.</p><div class="post-list">{matching.map((post) => <article class="post-row"><time datetime={post.id.slice(0, 10)}>{dateLabel(post, 'en')}</time><div><span class="post-language" aria-label="Language: English">EN</span><h2 lang="en"><a href={`/en${postUrl(post)}`}>{post.data.title}</a></h2><p lang="en">{excerpt(post, 'en')}</p></div><a class="row-link" href={`/en${postUrl(post)}`} aria-label={`Read: ${post.data.title}`}>Read <span aria-hidden="true">↗</span></a></article>)}</div></section>
</Base>
