---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import projects from '../data/projects.json';
import skills from '../data/skills.json';
import { posts, postUrl, excerpt, label } from '../lib/content.js';

const featured = ['Python Runner', 'Find & Replace', 'Indexium'].map((name) => projects.find((project) => project.name
=== name));
const groups = [
['Backend & API', ['Python', 'Django']],
['Données', ['PostgreSQL']],
['Infrastructure & DevOps', ['Docker', 'Linux', 'CI / CD']],
['Interfaces', ['JavaScript']],
['Outils & qualité', ['Rust', 'Testing']],
];
const allPosts = await posts();
const articles = [
'safely-expose-self-hosted-services',
'transmission-gluetun-setup',
'create-an-anacron',
].map((name) => allPosts.find((post) => post.id.endsWith(name))).filter(Boolean);
---
<Base title="Développeur backend Python & infrastructure"
  description="Rayan, développeur Freelance : backend, données et infrastructure. Découvrez ses projets personnels, compétences et notes techniques.">
<section class="hero">
  <div class="shell hero-inner">
    <p class="eyebrow">Rayan · Développeur Freelance</p>
    <h1>Applications, données, déploiement</h1>
    <div class="hero-base">
      <p>Développeur Freelance spécialisé en backend, données et infrastructures.</p>
      <div class="hero-actions"><a class="button" href="#projets">Voir mes projets <span
            aria-hidden="true">↗</span></a><a class="text-link" href="https://flowshift.fr/" target="_blank"
          rel="noopener noreferrer">Découvrir Flowshift</a></div>
    </div>
    <div class="hero-trace" aria-hidden="true"><span>Concevoir</span><span>Construire</span><span>Déployer</span></div>
  </div>
</section>

<section class="section shell about-section" id="apropos" aria-labelledby="about-title">
  <div class="section-heading">
    <p class="section-kicker">À propos</p>
    <h2 id="about-title">Des outils utiles, du code à la production</h2>
  </div>
  <div class="about-content">
    <div>
      <p>Je suis Rayan, développeur indépendant. J’aime concevoir des outils utiles et performants, explorer le
        fonctionnement des systèmes et construire des solutions de bout en bout.</p>
      <p>Je travaille sur des sujets tels que le
        Web backend, le traitement des flux de données, la création d'API REST et l'automatisation, de la conception au
        déploiement en production.</p>
      <p><b>J’accompagne les entreprises dans leurs besoins logiciels via ma structure <a href="https://flowshift.fr/"
            target="_blank" rel="noopener noreferrer">Flowshift</a></b></p>
    </div>
    <div class="main-stack">
      <h3>Mon environnement principal</h3>
      <ul>
        <li>Python</li>
        <li>Django</li>
        <li>PostgreSQL</li>
        <li>Docker</li>
        <li>Linux</li>
      </ul>
    </div>
  </div>
</section>

<section class="section projects-section" id="projets" aria-labelledby="projects-title">
  <div class="shell">
    <div class="section-heading">
      <p class="section-kicker">Réalisations</p>
      <h2 id="projects-title">Projets personnels</h2>
      <p>Trois projets personnels, du script Python à l’outil en Rust et à la recherche avec Java.</p>
    </div>
    <ProjectGrid projects={featured} />
    <a class="section-more" href="/projets/">Voir tous mes projets <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="section skills-section" id="competences" aria-labelledby="skills-title">
  <div class="shell">
    <div class="section-heading">
      <p class="section-kicker">En pratique</p>
      <h2 id="skills-title">Compétences</h2>
    </div>
    <div class="skills-groups">{groups.map(([title, names]) => <div class="skills-group">
        <h3>{title}</h3>
        <ul>{names.map((name) => { const skill = skills.find((item) => item.name === name); return <li>
            <strong>{skill.name}</strong><span>{skill.description.join(' ')}</span>
          </li>; })}</ul>
      </div>)}</div>
  </div>
</section>

<section class="section writing-section" aria-labelledby="writing-title">
  <div class="shell">
    <div class="section-heading">
      <p class="section-kicker">Blog</p>
      <h2 id="writing-title">Mes articles</h2>
    </div>
    <div class="writing-cards">{articles.map((post) => <article class="writing-card">
        <div class="writing-meta"><span>{label(post.data.tags[0] ||
            'Technique')}</span><span>{post.data.lang.toUpperCase()}</span></div>
        <h3 lang={post.data.lang}><a href={postUrl(post)}>{post.data.title}</a></h3>
        <p lang={post.data.lang}>{excerpt(post)}</p>
      </article>)}</div>
    <a class="section-more" href="/blog/">Voir tous les articles <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="contact-section" aria-labelledby="contact-title">
  <div class="shell contact-inner">
    <div>
      <p class="section-kicker">Contact</p>
      <h2 id="contact-title">On en parle ?</h2>
      <p>Pour échanger sur un projet, une collaboration ou une question technique. Pour une mission de développement,
        retrouvez aussi <a href="https://flowshift.fr/" target="_blank" rel="noopener noreferrer">Flowshift</a>.</p>
    </div><a class="button" href="mailto:contact@rayan.world">contact@rayan.world <span aria-hidden="true">↗</span></a>
  </div>
</section>
</Base>