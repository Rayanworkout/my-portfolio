---
import { Image } from 'astro:assets';

const { project } = Astro.props;
const images = import.meta.glob('../assets/projects/*.jpg', { eager: true, import: 'default' });
---

<article class="project-card">
  {project.image ? (
    <div class="project-card-image">
      <Image src={images[`../assets/projects/${project.image}.jpg`]} width={680} format="webp" alt="" loading="lazy" />
    </div>
  ) : (
    <div class="project-card-visual" aria-hidden="true">
      {project.visual.map((part) => <span>{part}</span>)}
    </div>
  )}
  <div class="project-card-body">
    <span class="project-kind">{project.kind === 'Client' ? 'Mission client' : 'Projet perso'}</span>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
    <ul class="tag-list" aria-label={`Technologies pour ${project.name}`}>
      {project.keywords.map((keyword) => <li>{keyword}</li>)}
    </ul>
    {(project.link || project.githubLink) && <div class="project-card-links">
      {project.link && <a href={project.link}>Voir le projet <span aria-hidden="true">↗</span></a>}
      {project.githubLink && <a href={project.githubLink}>Code source <span aria-hidden="true">↗</span></a>}
    </div>}
  </div>
</article>
